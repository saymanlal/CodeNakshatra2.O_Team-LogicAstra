{
  "outputDirectory": "frontend",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/block/:index",
      "destination": "/index.html"
    },
    {
      "source": "/tx/:hash",
      "destination": "/index.html"
    },
    {
      "source": "/contract/:addr",
      "destination": "/index.html"
    }
  ]
}
